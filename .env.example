# Copy this file to .env and put your key on the next line.
# .env is gitignored. Do not commit a real key.
# Create a key at https://console.x.ai/
XAI_API_KEY=

# Optional. Official text model for code as of the current docs.
XAI_MODEL=grok-4.7

# Optional HTTP timeout in seconds. Official samples use a long timeout
# because grok-4.7 is a reasoning model. Raise this if calls time out.
XAI_TIMEOUT=120

# Optional. Investigation stops executing tools after this many rounds
# and makes one fresh no-tool request for the root-cause JSON.
LEDGER_MAX_TOOL_ROUNDS=8
